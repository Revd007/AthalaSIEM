<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  
  <Package Name="AthalaSIEM Universal Agent" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="Athala Security Systems" 
           UpgradeCode="A7B8C9D0-1234-5678-9ABC-DEF012345678">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AthalaSIEM Universal Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Installation properties (like Splunk UF) -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    
    <!-- Configuration properties for enterprise deployment -->
    <Property Id="MANAGER_IP" Value="192.168.1.100" />
    <Property Id="MANAGER_PORT" Value="9595" />
    <Property Id="AGENT_NAME" Value="AthalaSIEM-Agent" />
    <Property Id="DEPLOYMENT_TOKEN" Secure="yes" />
    <Property Id="AUTO_START" Value="1" />

    <!-- Command line parameter support (like other SIEM agents) -->
    <SetProperty Id="MANAGER_IP" Value="[MANAGERIP]" After="AppSearch" Condition="MANAGERIP" />
    <SetProperty Id="MANAGER_PORT" Value="[MANAGERPORT]" After="AppSearch" Condition="MANAGERPORT" />
    <SetProperty Id="AGENT_NAME" Value="[NAME]" After="AppSearch" Condition="NAME" />
    <SetProperty Id="DEPLOYMENT_TOKEN" Value="[TOKEN]" After="AppSearch" Condition="TOKEN" />

    <!-- Directory structure (64-bit application) -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="ManufacturerFolder" Name="Athala Security">
        <Directory Id="INSTALLFOLDER" Name="SIEM Universal Agent">
          <Directory Id="LOGSFOLDER" Name="logs" />
          <Directory Id="CONFIGFOLDER" Name="config" />
        </Directory>
      </Directory>
    </StandardDirectory>
      
    <!-- Start Menu -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AthalaSIEM Universal Agent" />
    </StandardDirectory>

    <!-- Main application files -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      
      <!-- Main executable and all dependencies -->
      <Component Id="MainExecutable" Guid="0D615A60-CF57-40E2-BCE5-6EF5327DB491">
        <File Id="AgentEXE" Source="$(var.SourceDir)\athala-agent.exe" KeyPath="yes" />
        <File Id="AgentDLL" Source="$(var.SourceDir)\athala-agent.dll" />
        <File Id="RuntimeConfig" Source="$(var.SourceDir)\athala-agent.runtimeconfig.json" />
        <File Id="DepsJson" Source="$(var.SourceDir)\athala-agent.deps.json" />

        <!-- Windows Service (like Splunk/Wazuh) -->
        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="AthalaSIEMUniversalAgent"
                        DisplayName="AthalaSIEM Universal Agent"
                        Description="Enterprise SIEM log collection agent. Collects Windows Event Logs for security monitoring."
                        Start="auto"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no"
                        Vital="yes">
          
          <!-- Service recovery like enterprise tools -->
          <util:ServiceConfig
             FirstFailureActionType="restart"
             SecondFailureActionType="restart"
             ThirdFailureActionType="restart"
             RestartServiceDelayInSeconds="60"
             ResetPeriodInDays="1" />
        </ServiceInstall>

        <ServiceControl Id="StartService"
                        Name="AthalaSIEMUniversalAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!-- Runtime Files Component - Will be populated by build script -->
      <Component Id="RuntimeFilesComponent" Guid="0D615A60-CF57-40E2-BCE5-6EF5327DB496">
        <CreateFolder />
      </Component>

      <!-- Application registry (for CLI access) -->
      <Component Id="AppPathRegistry" Guid="0D615A60-CF57-40E2-BCE5-6EF5327DB493">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\athala-agent.exe"
                      Value="[INSTALLFOLDER]athala-agent.exe" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\athala-agent.exe"
                      Name="Path" Value="[INSTALLFOLDER]" Type="string" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu shortcuts (simple like enterprise tools) -->
    <ComponentGroup Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcuts" Guid="0D615A60-CF57-40E2-BCE5-6EF5327DB494">
        
        <!-- Agent Console (for testing) -->
        <Shortcut Id="ConsoleShortcut"
                  Name="Agent Console"
                  Description="Run agent in console mode"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--console"
                  WorkingDirectory="INSTALLFOLDER" />

        <!-- Test Connection -->
        <Shortcut Id="TestShortcut"
                  Name="Test Connection"
                  Description="Test backend connection"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--test-connection"
                  WorkingDirectory="INSTALLFOLDER" />

        <!-- View Logs -->
        <Shortcut Id="LogsShortcut"
                  Name="View Logs"
                  Description="Open logs folder"
                  Target="[LOGSFOLDER]" />

        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSecurity\UniversalAgent" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Create log directories -->
    <ComponentGroup Id="LogComponents" Directory="LOGSFOLDER">
      <Component Id="LogFolderComponent" Guid="0D615A60-CF57-40E2-BCE5-6EF5327DB495">
        <CreateFolder>
          <Permission User="Everyone" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- Feature definition (simple like enterprise tools) -->
    <Feature Id="CompleteFeature" Title="AthalaSIEM Universal Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
      <ComponentGroupRef Id="LogComponents" />
    </Feature>

    <!-- Professional GUI installer (NOT silent by default) -->
    <!-- WiX v5 simplified UI approach -->

    <!-- Install sequence with file copy and configuration update -->
    <InstallExecuteSequence>
      <!-- Copy all runtime files -->
      <Custom Action="CopyRuntimeFiles" After="InstallFiles" Condition="NOT Installed" />
      <!-- Update configuration after files are copied -->
      <Custom Action="UpdateConfiguration" After="CopyRuntimeFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- Custom action to copy all runtime files -->
    <CustomAction Id="CopyRuntimeFiles"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -Command &quot;$sourceDir = '$(var.SourceDir)'; $destDir = Get-Location; if (Test-Path $sourceDir) { Get-ChildItem $sourceDir -Recurse | ForEach-Object { $dest = $_.FullName.Replace($sourceDir, $destDir); if ($_.PSIsContainer) { New-Item -ItemType Directory -Path $dest -Force | Out-Null } else { Copy-Item $_.FullName $dest -Force } } }&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom action to update appsettings.json -->
    <CustomAction Id="UpdateConfiguration"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -Command &quot;if (Test-Path 'appsettings.json') { $config = Get-Content 'appsettings.json' | ConvertFrom-Json; $config.SiemManager.ManagerIP = '[MANAGER_IP]'; $config.SiemManager.ManagerPort = [MANAGER_PORT]; $config.Agent.Name = '[AGENT_NAME]'; if ('[DEPLOYMENT_TOKEN]' -ne '') { $config.Agent.RegistrationKey = '[DEPLOYMENT_TOKEN]' }; $config | ConvertTo-Json -Depth 10 | Set-Content 'appsettings.json' }&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Icon and properties -->
    <Icon Id="AgentIcon.ico" SourceFile="$(var.SourceDir)\athala-agent.exe" />
    <Property Id="ARPPRODUCTICON" Value="AgentIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://docs.athala-siem.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.athala-siem.com" />
    <Property Id="ARPNOREPAIR" Value="1" />

  </Package>
</Wix> 