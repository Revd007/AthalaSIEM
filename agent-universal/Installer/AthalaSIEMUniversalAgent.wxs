<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="AthalaSIEM Universal Agent"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="AthalaSIEM Technologies"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           InstallerVersion="500"
           Compressed="yes">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of AthalaSIEM Universal Agent is already installed."
                  AllowSameVersionUpgrades="yes" />

    <!-- Configuration Properties -->
    <Property Id="ARPPRODUCTICON" Value="AthalaSIEMIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/athala/siem" />
    <Property Id="ARPURLINFOABOUT" Value="https://athala.io" />
    
    <!-- WixUI_InstallDir requires this property to link to the installation directory -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

    <!-- Installer Properties for Configuration (IP:port format like other SIEM tools) -->
    <!-- Optional properties can be set via command line - use SetProperty for defaults -->
    <Property Id="BACKENDURL" Admin="yes" />
    <Property Id="GRPCURL" Admin="yes" />
    <Property Id="BACKENDPORT" Value="9595" />
    <Property Id="GRPCPORT" Value="50051" />
    <Property Id="AGENTNAME" Admin="yes" />
    <Property Id="DEPLOYMENTTOKEN" Secure="yes" Admin="yes" />
    <Property Id="USEHTTPS" Value="0" />
    <Property Id="USEGRPC" Value="1" />
    
    <!-- Set default values for optional properties if not provided (Execute sequence only) -->
    <!-- Use Before to ensure defaults are set before CA_* properties are set -->
    <SetProperty Id="BACKENDURL" Value="[COMPUTERNAME]:9595" Before="CostFinalize" Sequence="execute" Condition="BACKENDURL = &quot;&quot;" />
    <SetProperty Id="GRPCURL" Value="[COMPUTERNAME]:50051" Before="CostFinalize" Sequence="execute" Condition="GRPCURL = &quot;&quot;" />
    <SetProperty Id="AGENTNAME" Value="[COMPUTERNAME]-Agent" Before="CostFinalize" Sequence="execute" Condition="AGENTNAME = &quot;&quot;" />

    <!-- Installation Directory -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyDir" Name="Athala Security">
        <Directory Id="INSTALLDIR" Name="SIEM Universal Agent">
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Main Application Files -->
    <ComponentGroup Id="MainApplicationFiles">
      <Component Id="MainExecutable" Directory="INSTALLDIR" Guid="12345678-1234-1234-1234-123456789012">
        <File Id="AthalaSIEMAgentEXE" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.exe"
              KeyPath="yes" />
        <File Id="AthalaSIEMAgentDLL" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.dll" />
        <File Id="AppSettings" 
              Source="..\bin\Release\net8.0\win-x64\publish\appsettings.json" />
        <File Id="ConfigureScript" 
              Source="..\bin\Release\net8.0\win-x64\publish\ConfigureAppSettings.ps1" />
        <File Id="RuntimeConfig" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.runtimeconfig.json" />
        <File Id="DepsJson" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.deps.json" />
        <File Id="DebugSymbols" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.pdb" />
        
        <!-- Windows Service Configuration - Manual start after config -->
        <ServiceInstall Id="AthalaSIEMService"
                        Type="ownProcess"
                        Name="AthalaSIEMUniversalAgent"
                        DisplayName="AthalaSIEM Universal Agent"
                        Description="AthalaSIEM Universal Agent for comprehensive log collection and security monitoring"
                        Start="demand"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no"
                        />
        <ServiceControl Id="ServiceControl"
                        Name="AthalaSIEMUniversalAgent"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
                        <!-- Removed Start="install" to prevent auto-start during installation -->
                        <!-- Service starts on demand or manually after config is complete -->
      </Component>
    </ComponentGroup>

