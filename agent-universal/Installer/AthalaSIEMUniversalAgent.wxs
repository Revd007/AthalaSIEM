        <File Id="DepsJson" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.deps.json" />
        <File Id="DebugSymbols" 
              Source="..\bin\Release\net8.0\win-x64\publish\athala-agent.pdb" />
        
        <!-- Windows Service Configuration - Manual start after config -->
        <ServiceInstall Id="AthalaSIEMService"
                        Type="ownProcess"
                        Name="AthalaSIEMUniversalAgent"
                        DisplayName="AthalaSIEM Universal Agent"
                        Description="AthalaSIEM Universal Agent for comprehensive log collection and security monitoring"
                        Start="demand"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no"
                        Arguments="--service" />
        <ServiceControl Id="ServiceControl"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Name="AthalaSIEMUniversalAgent"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

