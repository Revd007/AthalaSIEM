    <!-- Custom Action to Configure appsettings.json after installation (IP:port format) -->
    <!-- Store properties for deferred custom action (properties can't be accessed directly in deferred actions) -->
    <!-- Simplified: Pass properties as-is, let PowerShell script handle defaults -->
    <SetProperty Id="CA_InstallPath" Value="[INSTALLDIR]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_BackendUrl" Value="[BACKENDURL]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_GrpcUrl" Value="[GRPCURL]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_BackendPort" Value="[BACKENDPORT]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_GrpcPort" Value="[GRPCPORT]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_AgentName" Value="[AGENTNAME]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_DeploymentToken" Value="[DEPLOYMENTTOKEN]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_UseHTTPS" Value="[USEHTTPS]" After="CostFinalize" Sequence="execute" />
    <SetProperty Id="CA_UseGrpc" Value="[USEGRPC]" After="CostFinalize" Sequence="execute" />
    
    <CustomAction Id="ConfigureAppSettings"
                  Directory="INSTALLDIR"
                  Execute="deferred"
                  Impersonate="no"
                  ExeCommand="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -WindowStyle Hidden -File [INSTALLDIR]ConfigureAppSettings.ps1 -InstallPath [CA_InstallPath] -BackendUrl [CA_BackendUrl] -GrpcUrl [CA_GrpcUrl] -BackendPort [CA_BackendPort] -GrpcPort [CA_GrpcPort] -AgentName [CA_AgentName] -DeploymentToken [CA_DeploymentToken] -UseHTTPS [CA_UseHTTPS] -UseGrpc [CA_UseGrpc]"
                  Return="ignore" />

    <!-- Schedule Custom Action -->
    <!-- Configure appsettings.json BEFORE service is installed/started -->
    <InstallExecuteSequence>
      <Custom Action="ConfigureAppSettings" Before="InstallServices" />
    </InstallExecuteSequence>

    <!-- Features -->
    <Feature Id="Complete" Level="1">
      <ComponentGroupRef Id="MainApplicationFiles" />
      <ComponentGroupRef Id="DotNetRuntimeFiles" />
      <ComponentGroupRef Id="MicrosoftExtensionsFiles" />
      <ComponentGroupRef Id="SystemLibrariesFiles" />
      <ComponentGroupRef Id="GrpcDependencies" />
      <ComponentGroupRef Id="RemainingRuntimeDlls" />
    </Feature>

    <!-- Custom UI with Configuration Dialog -->
    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
      
      <!-- Navigate from Welcome to Config Dialog -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="ConfigDlg" />
      
      <!-- Navigate from Config Dialog back to Welcome -->
      <Publish Dialog="ConfigDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      
      <!-- Navigate from Config Dialog to InstallDir Dialog -->
      <Publish Dialog="ConfigDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />
      
      <!-- Navigate from InstallDir Dialog back to Config -->
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ConfigDlg" />
      
      <!-- Custom Configuration Dialog -->
      <Dialog Id="ConfigDlg" Width="370" Height="270" Title="AthalaSIEM Agent Configuration">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes">
          <Text Value="{\WixUI_Font_Title}Backend Configuration" />
        </Control>
        
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="30" Transparent="yes" NoPrefix="yes">
          <Text Value="Enter the backend server connection details (IP:port format like Wazuh or Splunk)." />
        </Control>
        
        <!-- Backend URL/IP -->
        <Control Id="BackendUrlLabel" Type="Text" X="25" Y="60" Width="100" Height="15" NoPrefix="yes">
          <Text Value="Backend IP/URL:" />
        </Control>
        <Control Id="BackendUrlEdit" Type="Edit" X="130" Y="58" Width="200" Height="18" Property="BACKENDURL" />
        
        <!-- Backend Port -->
        <Control Id="BackendPortLabel" Type="Text" X="25" Y="90" Width="100" Height="15" NoPrefix="yes">
          <Text Value="Backend Port:" />
        </Control>
        <Control Id="BackendPortEdit" Type="Edit" X="130" Y="88" Width="200" Height="18" Property="BACKENDPORT" />
        
        <!-- gRPC URL/IP -->
        <Control Id="GrpcUrlLabel" Type="Text" X="25" Y="120" Width="100" Height="15" NoPrefix="yes">
          <Text Value="gRPC IP/URL:" />
        </Control>
        <Control Id="GrpcUrlEdit" Type="Edit" X="130" Y="118" Width="200" Height="18" Property="GRPCURL" />
        
        <!-- Agent Name -->
        <Control Id="AgentNameLabel" Type="Text" X="25" Y="150" Width="100" Height="15" NoPrefix="yes">
          <Text Value="Agent Name:" />
        </Control>
        <Control Id="AgentNameEdit" Type="Edit" X="130" Y="148" Width="200" Height="18" Property="AGENTNAME" />
        
        <!-- Deployment Token (optional) -->
        <Control Id="DeploymentTokenLabel" Type="Text" X="25" Y="180" Width="100" Height="15" NoPrefix="yes">
          <Text Value="Deployment Token:" />
        </Control>
        <Control Id="DeploymentTokenEdit" Type="Edit" X="130" Y="178" Width="200" Height="18" Property="DEPLOYMENTTOKEN" Password="yes" />
        
        <!-- Navigation Buttons -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel" />
      </Dialog>
    </UI>
    
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />

  </Package>
</Wix> 