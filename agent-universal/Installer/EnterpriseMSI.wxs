<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" 
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="AthalaSIEM Universal Agent" 
           Language="1033" 
           Version="1.0.0.0" 
           Manufacturer="Athala Security Systems" 
           UpgradeCode="F7B8C9D0-1234-5678-9ABC-DEF012345678"
           InstallerVersion="500"
           Compressed="yes"
           Scope="perMachine">
    
    <!-- Product description -->
    <SummaryInformation Keywords="SIEM,Security,Monitoring,Agent,Enterprise"
                       Description="AthalaSIEM Universal Agent - Enterprise security monitoring and log collection"
                       Manufacturer="Athala Security Systems" />

    <!-- Major upgrade handling -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall the newer version first." 
                  Schedule="afterInstallInitialize" />
    
    <!-- Media template for CAB embedding -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ========================================= -->
    <!-- INSTALLER PROPERTIES -->
    <!-- ========================================= -->
    
    <!-- Installation directory property (defined below in UI section) -->
    
    <!-- Configuration Properties -->
    <Property Id="SIEM_BACKEND_URL" Secure="yes" />
    <Property Id="DEPLOYMENT_TOKEN" Secure="yes" />
    <Property Id="AGENT_NAME" Value="[ComputerName]-Universal" />
    <Property Id="AUTO_START_SERVICE" Value="1" />
    <Property Id="USE_HTTPS" Value="0" />
    <Property Id="ENABLE_FIM" Value="1" />
    <Property Id="ENABLE_REGISTRY_MONITORING" Value="1" />
    <Property Id="ENABLE_EVENT_CORRELATION" Value="1" />
    
    <!-- Installation behavior properties -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <Property Id="REBOOT" Value="Suppress" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    
    <!-- Company and product information for Add/Remove Programs -->
    <Property Id="ARPCOMMENTS" Value="Enterprise SIEM Agent for comprehensive security monitoring" />
    <Property Id="ARPCONTACT" Value="support@athalasecurity.com" />
    <Property Id="ARPHELPLINK" Value="https://docs.athalasiem.com" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.athalasiem.com" />
    <Property Id="ARPSIZE" Value="50000" />
    
    <!-- Allow command line property overrides -->
    <SetProperty Id="SIEM_BACKEND_URL" Value="[BACKENDURL]" After="AppSearch" Condition="BACKENDURL" />
    <SetProperty Id="DEPLOYMENT_TOKEN" Value="[TOKEN]" After="AppSearch" Condition="TOKEN" />
    <SetProperty Id="AGENT_NAME" Value="[NAME]" After="AppSearch" Condition="NAME" />
    <SetProperty Id="AUTO_START_SERVICE" Value="[AUTOSTART]" After="AppSearch" Condition="AUTOSTART" />

    <!-- ========================================= -->
    <!-- DIRECTORY STRUCTURE -->
    <!-- ========================================= -->
    
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="Athala Security">
        <Directory Id="INSTALLFOLDER" Name="AthalaSIEM Universal Agent">
          <!-- Application directories -->
          <Directory Id="BinFolder" Name="bin" />
          <Directory Id="ConfigFolder" Name="config" />
          <Directory Id="LogsFolder" Name="logs" />
          <Directory Id="ArchivesFolder" Name="archives" />
          <Directory Id="CertificatesFolder" Name="certificates" />
          <Directory Id="AgentTempFolder" Name="temp" />
          <Directory Id="DocsFolder" Name="docs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Start Menu folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AthalaSIEM Universal Agent" />
    </StandardDirectory>

    <!-- Desktop shortcuts -->
    <StandardDirectory Id="DesktopFolder" />

    <!-- ========================================= -->
    <!-- COMPONENT DEFINITIONS -->
    <!-- ========================================= -->

    <!-- Main Application Components -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      
      <!-- Main executable -->
      <Component Id="MainExecutable" Guid="F7B8C9D0-1111-5678-9ABC-DEF012345678">
        <File Id="AgentEXE" 
              Source="$(var.SourceDir)\athala-agent.exe" 
              KeyPath="yes"
              Checksum="yes" />
        
        <!-- Windows Service Installation -->
        <ServiceInstall Id="ServiceInstaller"
                        Type="ownProcess"
                        Name="AthalaSIEMUniversalAgent"
                        DisplayName="AthalaSIEM Universal Agent"
                        Description="Enterprise SIEM agent providing log collection, file integrity monitoring, registry monitoring, and security correlation for Windows systems"
                        Start="demand"
                        Account="LocalSystem"
                        ErrorControl="normal"
                        Interactive="no"
                        Vital="no">
          <ServiceDependency Id="Eventlog" />
          <ServiceDependency Id="Tcpip" />
        </ServiceInstall>

        <!-- Service Control - Don't start during installation -->
        <ServiceControl Id="ServiceControl"
                        Name="AthalaSIEMUniversalAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!-- Configuration files -->
      <Component Id="ConfigurationFiles" Guid="F7B8C9D0-2222-5678-9ABC-DEF012345678">
        <File Id="AppSettingsJSON" 
              Source="$(var.SourceDir)\appsettings.json" 
              KeyPath="yes" />
        <File Id="RuntimeConfigJSON" 
              Source="$(var.SourceDir)\athala-agent.runtimeconfig.json" />
        <File Id="DepsJSON" 
              Source="$(var.SourceDir)\athala-agent.deps.json" />
      </Component>

      <!-- Application DLLs -->
      <Component Id="ApplicationLibraries" Guid="F7B8C9D0-3333-5678-9ABC-DEF012345678">
        <File Id="AgentDLL" 
              Source="$(var.SourceDir)\athala-agent.dll" 
              KeyPath="yes" />
        <!-- Additional DLLs will be added here based on publish output -->
      </Component>

      <!-- Documentation - commented out for basic MSI build -->
      <!-- <Component Id="Documentation" Guid="F7B8C9D0-4444-5678-9ABC-DEF012345678" Directory="DocsFolder">
        <File Id="README" 
              Source="$(var.SourceDir)\README.md" 
              KeyPath="yes" />
        <File Id="InstallationGuide" 
              Source="$(var.SourceDir)\INSTALLATION-GUIDE.md" />
        <File Id="ConfigurationGuide" 
              Source="$(var.SourceDir)\ENTERPRISE-CONFIGURATION-SUMMARY.md" />
        <File Id="SecurityGuide" 
              Source="$(var.SourceDir)\SECURITY-CONFIGURATION-GUIDE.md" />
        <File Id="LicenseFile" 
              Source="$(var.SourceDir)\LICENSE.rtf" />
      </Component> -->
    </ComponentGroup>

    <!-- Registry Configuration Components -->
    <ComponentGroup Id="RegistryConfiguration" Directory="INSTALLFOLDER">
      
      <!-- Application Registry Keys -->
      <Component Id="ApplicationRegistry" Guid="F7B8C9D0-5555-5678-9ABC-DEF012345678">
        <RegistryKey Root="HKLM" Key="SOFTWARE\AthalaSIEM\UniversalAgent">
          <RegistryValue Name="InstallPath" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          <RegistryValue Name="Version" Value="1.0.0" Type="string" />
          <RegistryValue Name="InstallDate" Value="[Date]" Type="string" />
          <RegistryValue Name="ServiceName" Value="AthalaSIEMUniversalAgent" Type="string" />
        </RegistryKey>
      </Component>

      <!-- Configuration Registry -->
      <Component Id="ConfigurationRegistry" Guid="F7B8C9D0-6666-5678-9ABC-DEF012345678">
        <RegistryKey Root="HKLM" Key="SOFTWARE\AthalaSIEM\UniversalAgent\Configuration">
          <RegistryValue Name="BackendUrl" Value="[SIEM_BACKEND_URL]" Type="string" KeyPath="yes" />
          <RegistryValue Name="AgentName" Value="[AGENT_NAME]" Type="string" />
          <RegistryValue Name="AutoStartService" Value="[AUTO_START_SERVICE]" Type="string" />
          <RegistryValue Name="UseHttps" Value="[USE_HTTPS]" Type="string" />
          <RegistryValue Name="EnableFIM" Value="[ENABLE_FIM]" Type="string" />
          <RegistryValue Name="EnableRegistryMonitoring" Value="[ENABLE_REGISTRY_MONITORING]" Type="string" />
          <RegistryValue Name="EnableEventCorrelation" Value="[ENABLE_EVENT_CORRELATION]" Type="string" />
          <RegistryValue Name="ConfigurationSource" Value="MSI" Type="string" />
        </RegistryKey>
      </Component>

      <!-- Windows App Paths Registration -->
      <Component Id="AppPathRegistry" Guid="F7B8C9D0-7777-5678-9ABC-DEF012345678">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\athala-agent.exe">
          <RegistryValue Value="[INSTALLFOLDER]athala-agent.exe" Type="string" KeyPath="yes" />
          <RegistryValue Name="Path" Value="[INSTALLFOLDER]" Type="string" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Directory Components -->
    <ComponentGroup Id="DirectoryStructure">
      
      <Component Id="LogsDirectory" Guid="F7B8C9D0-8888-5678-9ABC-DEF012345678" Directory="LogsFolder">
        <CreateFolder />
        <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Folders" Name="LogsFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ConfigDirectory" Guid="F7B8C9D0-9999-5678-9ABC-DEF012345678" Directory="ConfigFolder">
        <CreateFolder />
        <RemoveFolder Id="RemoveConfigFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Folders" Name="ConfigFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ArchivesDirectory" Guid="F7B8C9D0-AAAA-5678-9ABC-DEF012345678" Directory="ArchivesFolder">
        <CreateFolder />
        <RemoveFolder Id="RemoveArchivesFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Folders" Name="ArchivesFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="CertificatesDirectory" Guid="F7B8C9D0-BBBB-5678-9ABC-DEF012345678" Directory="CertificatesFolder">
        <CreateFolder />
        <RemoveFolder Id="RemoveCertificatesFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Folders" Name="CertificatesFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="TempDirectory" Guid="F7B8C9D0-CCCC-5678-9ABC-DEF012345678" Directory="AgentTempFolder">
        <CreateFolder />
        <RemoveFolder Id="RemoveTempFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Folders" Name="TempFolder" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu Shortcuts -->
    <ComponentGroup Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder">
      
      <Component Id="ApplicationShortcuts" Guid="F7B8C9D0-DDDD-5678-9ABC-DEF012345678">
        
        <!-- Agent Configuration Shortcut -->
        <Shortcut Id="ConfigureAgentShortcut"
                  Name="Configure Agent"
                  Description="Configure AthalaSIEM Universal Agent settings"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--configure"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AgentIcon" />

        <!-- Test Connection Shortcut -->
        <Shortcut Id="TestConnectionShortcut"
                  Name="Test SIEM Connection"
                  Description="Test connection to SIEM backend"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--test-connection"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AgentIcon" />

        <!-- Agent Status Shortcut -->
        <Shortcut Id="AgentStatusShortcut"
                  Name="Agent Status"
                  Description="View AthalaSIEM Universal Agent status"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--status"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AgentIcon" />

        <!-- Documentation Shortcut - commented out for basic MSI -->
        <!-- <Shortcut Id="DocumentationShortcut"
                  Name="Documentation"
                  Description="AthalaSIEM Universal Agent Documentation"
                  Target="[DocsFolder]README.md"
                  WorkingDirectory="DocsFolder" /> -->

        <!-- Uninstall Shortcut -->
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall AthalaSIEM Universal Agent"
                  Description="Remove AthalaSIEM Universal Agent from this computer"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />

        <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Desktop Shortcut (Optional) -->
    <ComponentGroup Id="DesktopShortcuts" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="F7B8C9D0-EEEE-5678-9ABC-DEF012345678" Condition="DESKTOP_SHORTCUT">
        <Shortcut Id="DesktopAgentShortcut"
                  Name="AthalaSIEM Agent"
                  Description="AthalaSIEM Universal Agent"
                  Target="[INSTALLFOLDER]athala-agent.exe"
                  Arguments="--status"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AgentIcon" />
        <RegistryValue Root="HKCU" Key="Software\AthalaSIEM\UniversalAgent\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ========================================= -->
    <!-- CUSTOM ACTIONS -->
    <!-- ========================================= -->

    <!-- Custom Action to configure agent after installation -->
    <CustomAction Id="ConfigureAgent"
                  ExeCommand="[INSTALLFOLDER]athala-agent.exe --configure-msi"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Custom Action to test connection -->
    <CustomAction Id="TestConnection"
                  ExeCommand="[INSTALLFOLDER]athala-agent.exe --test-connection-silent"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom Action to set service to automatic start and start it -->
    <CustomAction Id="ConfigureAndStartService"
                  ExeCommand="cmd /c &quot;sc config AthalaSIEMUniversalAgent start= auto &amp;&amp; sc start AthalaSIEMUniversalAgent&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Custom Action to install .NET runtime if needed -->
    <CustomAction Id="CheckDotNetRuntime"
                  ExeCommand="[INSTALLFOLDER]athala-agent.exe --check-runtime"
                  Directory="INSTALLFOLDER"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ========================================= -->
    <!-- INSTALLATION SEQUENCE -->
    <!-- ========================================= -->

    <InstallExecuteSequence>
      <Custom Action="CheckDotNetRuntime" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="ConfigureAgent" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="TestConnection" After="ConfigureAgent" Condition="NOT REMOVE AND SIEM_BACKEND_URL" />
      <Custom Action="ConfigureAndStartService" After="TestConnection" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- ========================================= -->
    <!-- FEATURES -->
    <!-- ========================================= -->

    <Feature Id="MainFeature" 
             Title="AthalaSIEM Universal Agent Core" 
             Description="Core SIEM agent functionality including log collection, service management, and basic monitoring"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentGroupRef Id="RegistryConfiguration" />
      <ComponentGroupRef Id="DirectoryStructure" />
      <ComponentGroupRef Id="StartMenuShortcuts" />
    </Feature>

    <Feature Id="AdvancedMonitoring" 
             Title="Advanced Monitoring Features" 
             Description="File Integrity Monitoring (FIM), Registry monitoring, and advanced correlation features"
             Level="1">
      <!-- This feature is always installed but can be disabled via configuration -->
    </Feature>

    <Feature Id="DesktopShortcutFeature" 
             Title="Desktop Shortcut" 
             Description="Add shortcut to desktop for quick access to agent status"
             Level="2">
      <ComponentGroupRef Id="DesktopShortcuts" />
    </Feature>

    <!-- <Feature Id="Documentation" 
             Title="Documentation" 
             Description="Installation guides, configuration documentation, and help files"
             Level="1">
      <ComponentGroupRef Id="Documentation" />
    </Feature> -->

    <!-- ========================================= -->
    <!-- USER INTERFACE -->
    <!-- ========================================= -->

    <!-- Basic MSI - UI customization can be added later -->
    <!-- <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" /> -->
    
    <!-- License Agreement -->
    <!-- <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\LICENSE.rtf" /> -->
    
    <!-- Branding -->
    <!-- <WixVariable Id="WixUIBannerBmp" Value="$(var.SourceDir)\Installer\Banner.bmp" /> -->
    <!-- <WixVariable Id="WixUIDialogBmp" Value="$(var.SourceDir)\Installer\Dialog.bmp" /> -->

    <!-- ========================================= -->
    <!-- ICONS AND BRANDING -->
    <!-- ========================================= -->

    <!-- Application Icon -->
    <Icon Id="AgentIcon" SourceFile="$(var.SourceDir)\athala-agent.exe" />
    <Property Id="ARPPRODUCTICON" Value="AgentIcon" />

    <!-- ========================================= -->
    <!-- CONDITIONS AND REQUIREMENTS -->
    <!-- ========================================= -->

    <!-- Operating System Requirements -->
    <Launch Condition="VersionNT64 >= 600" 
            Message="This application requires Windows Vista/Server 2008 (64-bit) or later." />

    <!-- Administrator Rights Required -->
    <Launch Condition="Privileged" 
            Message="Administrator rights are required to install this application." />

    <!-- Deployment properties for silent installation -->
    <Property Id="MSILOGFILEMODE" Value="voicewarmup" />
    
  </Package>
</Wix> 